{
  "cli": {
    "version": ">= 5.0.0",
    "requireCommit": false
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://watchsphere-backend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_SOCKETIO_URL": "https://watchsphere-backend-production.up.railway.app",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://watchsphere-backend-production.up.railway.app/ws",
        "EXPO_PUBLIC_WEB_URL": "https://watchsphere.io",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "955042747601-rmv3aa0jkdng7erdclgaknio6uvh55hm.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "955042747601-7jhm21r5eovmd01n79fr93s70bnaifjt.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "955042747601-h8b96184tthv756vvuag5kcshhsih9qi.apps.googleusercontent.com"
      }
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://watchsphere-backend-production.up.railway.app/api/v1",
        "EXPO_PUBLIC_SOCKETIO_URL": "https://watchsphere-backend-production.up.railway.app",
        "EXPO_PUBLIC_WS_BASE_URL": "wss://watchsphere-backend-production.up.railway.app/ws",
        "EXPO_PUBLIC_WEB_URL": "https://watchsphere.io",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "955042747601-rmv3aa0jkdng7erdclgaknio6uvh55hm.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "955042747601-7jhm21r5eovmd01n79fr93s70bnaifjt.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "955042747601-h8b96184tthv756vvuag5kcshhsih9qi.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "YOUR_APPLE_ID@email.com",
        "ascAppId": "YOUR_APP_STORE_CONNECT_APP_ID",
        "appleTeamId": "YOUR_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal"
      }
    }
  }
}
