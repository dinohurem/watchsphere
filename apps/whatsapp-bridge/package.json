{
  "name": "@watchsphere/whatsapp-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Long-running WhatsApp client that streams dealer-group messages into the WatchSphere WTS/WTB pipeline",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "pair": "node dist/src/index.js --pair",
    "replay": "node dist/src/index.js --replay",
    "test": "npm run build && node --test dist/test/*.test.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "spike": "npm run build && node dist/src/spike.js"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "^9.5.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
