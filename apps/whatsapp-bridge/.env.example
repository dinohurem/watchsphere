# --- Required ---

# WatchSphere API root (must include /api/v1)
BRIDGE_API_BASE_URL=http://localhost:8787/api/v1

# Must match WHATSAPP_BRIDGE_TOKEN in the backend environment.
# Generate with: openssl rand -hex 32
BRIDGE_API_TOKEN=

# --- Scope ---

# Comma-separated group names (substring, case-insensitive) or exact JIDs.
# EMPTY CAPTURES NOTHING — this is deliberate. The bridge is paired to a real
# WhatsApp account and must only ever read the groups you name here.
BRIDGE_GROUPS=HK Dealers,EU Trade

# --- Optional ---

# Identifies this instance in the admin status view. Give each bridge its own.
BRIDGE_ID=bridge-1

# Where the paired session is stored. Back this up — losing it means re-pairing.
BRIDGE_AUTH_DIR=./auth

# Captures buffered on disk until the backend accepts them.
BRIDGE_OUTBOX_PATH=./data/outbox.jsonl

BRIDGE_FLUSH_INTERVAL_MS=10000
BRIDGE_HEARTBEAT_INTERVAL_MS=60000

# Max messages per request. The backend rejects anything above 1000.
BRIDGE_MAX_BATCH_SIZE=500

# Capture messages sent from the bridge's own number.
BRIDGE_CAPTURE_OWN_MESSAGES=false
