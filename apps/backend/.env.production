# Application
APP_NAME=WatchSphere
APP_VERSION=0.1.0
DEBUG=False
ENVIRONMENT=production

# API
API_V1_PREFIX=/api/v1
SECRET_KEY=your-production-secret-key-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net
MONGODB_DB_NAME=watchsphere_prod

# Redis
REDIS_URL=redis://your-redis-host:6379/0

# AI Services
OPENAI_API_KEY=your-openai-api-key

# CORS
ALLOWED_ORIGINS=https://watchsphere.io,https://www.watchsphere.io

# File Upload
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Firebase
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_STORAGE_BUCKET=watchsphere-1b903.firebasestorage.app

# Email (Postmark)
POSTMARK_API_KEY=your-postmark-api-key
EMAIL_FROM=hello@watchsphere.io
EMAIL_FROM_NAME=WatchSphere

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
APPLE_CLIENT_ID=your-apple-client-id
