# Application
APP_NAME=WatchSphere
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=watchsphere

# AI Services (OpenAI for AI chat)
OPENAI_API_KEY=your-openai-key

# Monri Payments
MONRI_MERCHANT_KEY=your-monri-merchant-key
MONRI_AUTHENTICITY_TOKEN=your-monri-authenticity-token
MONRI_API_URL=https://ipgtest.monri.com
MONRI_SUBSCRIPTION_PRICE=150.0
MONRI_CURRENCY=EUR

# CORS
ALLOWED_ORIGINS=http://localhost:5177,http://localhost:8081

# File Upload
MAX_UPLOAD_SIZE=10485760  # 10MB
UPLOAD_DIR=./uploads

# WhatsApp OTP delivery
# Driver: log (dev, code is only logged) | whapi | twilio
WHATSAPP_OTP_DRIVER=log
WHATSAPP_OTP_EXPIRY_MINUTES=10
# whapi.cloud
WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_TOKEN=
# Twilio WhatsApp Business
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
